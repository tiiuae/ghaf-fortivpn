+#define GHAF_AUTH_NAME "org.ghaf.FortiVpn.Authentication"
+#define GHAF_AUTH_PATH "/org/ghaf/FortiVpnAuthentication"
+#define GHAF_AUTH_IFACE "org.ghaf.FortiVpn.Authentication1"
+
+static gboolean
+ghaf_manages_profile (NMConnection *connection)
+{
+	const char *uuid = nm_connection_get_uuid (connection);
+	g_autofree char *record = NULL;
+
+	if (!uuid || !g_uuid_string_is_valid (uuid))
+		return FALSE;
+	record = g_build_filename ("/var/lib/ghaf/fortivpn", uuid, "auth.json", NULL);
+	return g_file_test (record, G_FILE_TEST_IS_REGULAR);
+}
+
+static void
+ghaf_authenticated (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+	g_autoptr(GTask) task = user_data;
+	NMOpenconnectPlugin *plugin = g_task_get_source_object (task);
+	NMOpenconnectPluginPrivate *priv = NM_OPENCONNECT_PLUGIN_GET_PRIVATE (plugin);
+	NMConnection *connection = g_task_get_task_data (task);
+	NMSettingVpn *vpn = nm_connection_get_setting_vpn (connection);
+	g_autoptr(GError) error = NULL;
+	g_autoptr(GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &error);
+	g_autoptr(GVariant) dict = NULL;
+	GVariantIter iter;
+	const char *key, *value;
+
+	if (priv->authentication != task)
+		return;
+	priv->authentication = NULL;
+	if (!reply) {
+		nm_vpn_service_plugin_failure (NM_VPN_SERVICE_PLUGIN (plugin), NM_VPN_PLUGIN_FAILURE_LOGIN_FAILED);
+		return;
+	}
+	nm_connection_clear_secrets (connection);
+	dict = g_variant_get_child_value (reply, 0);
+	g_variant_iter_init (&iter, dict);
+	while (g_variant_iter_next (&iter, "{&s&s}", &key, &value))
+		nm_setting_vpn_add_secret (vpn, key, value);
+	if (nm_openconnect_start_openconnect_binary (plugin, nm_connection_get_setting_connection (connection),
+	                                            vpn, &error) != 0)
+		nm_vpn_service_plugin_failure (NM_VPN_SERVICE_PLUGIN (plugin), NM_VPN_PLUGIN_FAILURE_CONNECT_FAILED);
+}
+
